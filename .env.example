# Copy this file to .env (never commit .env).
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# Leave empty for MOCK mode. Paste your own key from Google AI Studio for LIVE mode.
GEMINI_API_KEY=

# Free-tier Flash-Lite model (verified on ai.google.dev pricing, Nov 2026). Check AI Studio if it is retired.
GEMINI_MODEL=gemini-3.1-flash-lite

# auto = live when a key is present, mock = never call Gemini
AI_MODE=auto

GEMINI_TIMEOUT_SECONDS=10
LIVE_COOLDOWN_SECONDS=4
LIVE_MAX_PER_SESSION=30
